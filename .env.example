# Credentials from https://my.telegram.org/apps
APP_ID=123456
APP_HASH=0123456789abcdef0123456789abcdef

# Phone number in international format.
TG_PHONE=+10000000000

# Optional: where to store the session (default: ./session).
# TG_SESSION_DIR=session

# Optional: mark messages as sent by an agent.
# "footer" appends an italic line; "bot" routes messages through the inline
# echo bot so Telegram renders a "via @bot" header (needs `tgmcp echobot`).
# TG_ATTRIBUTION=footer
# TG_AGENT_FOOTER=sent by an agent
# TG_BOT_TOKEN=123456:AA...
# TG_ATTRIBUTION_STRICT=true

# Optional: serve downloaded files over HTTP instead of returning bytes, so
# large files never enter the model's context. Must be reachable by the client.
# TG_BLOB_BASE_URL=http://127.0.0.1:8080/blob
# TG_BLOB_TTL=15m

# Optional: telemetry. Exporters default to OTLP over gRPC to localhost:4317;
# set them to "none" to run without a collector.
# OTEL_TRACES_EXPORTER=none
# OTEL_METRICS_EXPORTER=none
# OTEL_LOGS_EXPORTER=none
